{
  "name": "opencode-env-manager",
  "version": "1.0.0",
  "description": "OpenCode plugin: per-directory environment profiles with an encrypted, per-command secret vault",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-dougan-maersk/opencode-env-manager.git"
  },
  "homepage": "https://github.com/craig-dougan-maersk/opencode-env-manager#readme",
  "bugs": {
    "url": "https://github.com/craig-dougan-maersk/opencode-env-manager/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "environment",
    "dotenv",
    "secrets",
    "vault",
    "age"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./tui.js",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "tui.js",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0"
  }
}
